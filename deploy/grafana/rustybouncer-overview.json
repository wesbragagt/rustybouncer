{
  "id": null,
  "uid": "rustybouncer-overview",
  "title": "Rustybouncer Overview",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "rustybouncer",
    "postgresql",
    "prometheus"
  ],
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "editable": true,
  "panels": [
    {
      "id": 1,
      "title": "HTTP scrape up",
      "type": "timeseries",
      "description": "HTTP collection health only; verify SQL with an independent probe.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"${job:regex}\",instance=~\"${instance:regex}\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "legendFormat": "{{instance}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 2,
      "title": "SELECT routing enabled",
      "type": "timeseries",
      "description": "0 means opaque passthrough: query panels have no observations.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rustybouncer_routing_enabled{job=~\"${job:regex}\",instance=~\"${instance:regex}\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "legendFormat": "{{instance}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 3,
      "title": "Routed Query messages / second",
      "type": "timeseries",
      "description": "One frontend Q message may contain multiple SQL statements.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rustybouncer:q_messages_per_second:rate5m{job=~\"${job:regex}\",instance=~\"${instance:regex}\"} and on (job,instance) (rustybouncer_routing_enabled{job=~\"${job:regex}\",instance=~\"${instance:regex}\"} == 1)",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "legendFormat": "{{instance}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 4,
      "title": "Query latency \u2014 all outcomes",
      "type": "timeseries",
      "description": "Includes routing, setup, retries and delivery. Quantiles mix successful and failed Q messages.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rustybouncer:q_duration_p50_seconds:rate5m{job=~\"${job:regex}\",instance=~\"${instance:regex}\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "legendFormat": "p50 {{instance}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        },
        {
          "refId": "B",
          "expr": "rustybouncer:q_duration_p95_seconds:rate5m{job=~\"${job:regex}\",instance=~\"${instance:regex}\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "legendFormat": "p95 {{instance}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        },
        {
          "refId": "C",
          "expr": "rustybouncer:q_duration_p99_seconds:rate5m{job=~\"${job:regex}\",instance=~\"${instance:regex}\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "legendFormat": "p99 {{instance}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 5,
      "title": "Query error ratios",
      "type": "timeseries",
      "description": "Empty windows remain No data; SQL errors and external aborts are separate from router errors.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rustybouncer:router_delivery_error_ratio:rate5m{job=~\"${job:regex}\",instance=~\"${instance:regex}\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "legendFormat": "router/delivery {{instance}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        },
        {
          "refId": "B",
          "expr": "rustybouncer:sql_error_ratio:rate5m{job=~\"${job:regex}\",instance=~\"${instance:regex}\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "legendFormat": "SQL/application {{instance}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        },
        {
          "refId": "C",
          "expr": "rustybouncer:aborted_ratio:rate5m{job=~\"${job:regex}\",instance=~\"${instance:regex}\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "legendFormat": "external abort {{instance}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 6,
      "title": "Retry amplification and attempt failures",
      "type": "timeseries",
      "description": "A recovered read may have failed attempts while its single logical Q message succeeds. Retry amplification may exceed 100%.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rustybouncer:read_retry_amplification:rate5m{job=~\"${job:regex}\",instance=~\"${instance:regex}\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "legendFormat": "additional selections/read {{instance}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        },
        {
          "refId": "B",
          "expr": "rustybouncer:attempt_failure_ratio:rate5m{job=~\"${job:regex}\",instance=~\"${instance:regex}\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "legendFormat": "failed attempts/all attempts {{instance}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 7,
      "title": "Client utilization",
      "type": "timeseries",
      "description": "Admitted clients divided by max_clients. This is frontend admission capacity.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rustybouncer:client_utilization:ratio{job=~\"${job:regex}\",instance=~\"${instance:regex}\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "legendFormat": "{{instance}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 8,
      "title": "Admitted clients and capacity",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rustybouncer_clients_active{job=~\"${job:regex}\",instance=~\"${instance:regex}\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "legendFormat": "active {{instance}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        },
        {
          "refId": "B",
          "expr": "rustybouncer_client_capacity{job=~\"${job:regex}\",instance=~\"${instance:regex}\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "legendFormat": "capacity {{instance}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 9,
      "title": "Frontend-owned backend streams",
      "type": "timeseries",
      "description": "Per-client cached TCP streams; excludes discovery probes. Remote closure may be detected later.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rustybouncer_backend_connections_active{job=~\"${job:regex}\",instance=~\"${instance:regex}\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "legendFormat": "{{instance}} / {{node}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 10,
      "title": "Queries in flight",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rustybouncer_queries_in_flight{job=~\"${job:regex}\",instance=~\"${instance:regex}\"} and on (job,instance) (rustybouncer_routing_enabled{job=~\"${job:regex}\",instance=~\"${instance:regex}\"} == 1)",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "legendFormat": "{{instance}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 11,
      "title": "Observed topology by router",
      "type": "timeseries",
      "description": "Each router observes the cluster independently; do not sum primary counts across routers.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rustybouncer_topology_nodes{job=~\"${job:regex}\",instance=~\"${instance:regex}\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "legendFormat": "{{instance}} / {{role}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        },
        {
          "refId": "B",
          "expr": "rustybouncer_topology_ambiguous{job=~\"${job:regex}\",instance=~\"${instance:regex}\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "legendFormat": "{{instance}} / ambiguous",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 12,
      "title": "Discovery age",
      "type": "timeseries",
      "description": "Age of the last completed round, including unchanged topology. See the configured freshness alert profile.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rustybouncer:discovery_age_seconds{job=~\"${job:regex}\",instance=~\"${instance:regex}\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "legendFormat": "{{instance}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 13,
      "title": "Eligible node roles",
      "type": "table",
      "description": "Eligibility from completed probes; this is not a leadership lease or proof of fencing.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rustybouncer_node_role{job=~\"${job:regex}\",instance=~\"${instance:regex}\"} == 1",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "legendFormat": "{{instance}} / {{node}} / {{role}}",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "id": 14,
      "title": "Observed transitions over five minutes",
      "type": "timeseries",
      "description": "Changes include transitions to/from no primary. These counts do not measure failover duration.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(rustybouncer_primary_changes_total{job=~\"${job:regex}\",instance=~\"${instance:regex}\"}[5m])",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "legendFormat": "primary identity {{instance}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        },
        {
          "refId": "B",
          "expr": "increase(rustybouncer_topology_changes_total{job=~\"${job:regex}\",instance=~\"${instance:regex}\"}[5m])",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "legendFormat": "topology {{instance}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "current": {}
      },
      {
        "name": "job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(up, job)",
        "refresh": 1,
        "current": {
          "text": "rustybouncer",
          "value": "rustybouncer"
        },
        "includeAll": false,
        "multi": false
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(up{job=~\"${job:regex}\"}, instance)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  }
}
